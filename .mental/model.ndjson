{"eventType":"EntityCreated","entityType":"decision","entityId":"dec-1768948436560","timestamp":"2026-01-20T22:33:56.560Z","version":1,"payload":{"id":"dec-1768948436560","what":"Event sourcing over direct state mutation","why":"Provides complete audit trail, enables time-travel to any point, supports undo/redo, and makes the model's evolution transparent","when":"2026-01-20T22:33:56.560Z","status":"active","relates_to":{"domains":["ModelEvent"],"aspects":["EventSourcing"]}}}
{"eventType":"EntityCreated","entityType":"decision","entityId":"dec-1768948436728","timestamp":"2026-01-20T22:33:56.728Z","version":1,"payload":{"id":"dec-1768948436728","what":"Pure command functions in shared package","why":"Separates business logic from I/O - enables testing without filesystem, allows reuse across CLI and potential future APIs, makes commands composable","when":"2026-01-20T22:33:56.728Z","status":"active","relates_to":{"capabilities":["AddEntity","UpdateEntity","DeleteEntity"]}}}
{"eventType":"EntityCreated","entityType":"decision","entityId":"dec-1768948436874","timestamp":"2026-01-20T22:33:56.874Z","version":1,"payload":{"id":"dec-1768948436874","what":"Four entity types: Domain, Capability, Aspect, Decision","why":"Maps to natural language patterns - nouns (what exists), verbs (what it does), adverbs (how governed), and rationale (why). Simpler than UML, captures what matters for understanding","when":"2026-01-20T22:33:56.874Z","status":"active","relates_to":{"domains":["Domain","Capability","Aspect","Decision"]}}}
{"eventType":"EntityCreated","entityType":"decision","entityId":"dec-1768948437017","timestamp":"2026-01-20T22:33:57.017Z","version":1,"payload":{"id":"dec-1768948437017","what":"Monorepo with cli, shared, web packages","why":"Clear separation of concerns - CLI handles I/O and user interaction, shared contains pure business logic, web provides visualization. Enables independent development and testing","when":"2026-01-20T22:33:57.017Z","status":"active","relates_to":{"domains":["MentalModel"]}}}
{"eventType":"EntityCreated","entityType":"decision","entityId":"dec-1768948437154","timestamp":"2026-01-20T22:33:57.154Z","version":1,"payload":{"id":"dec-1768948437154","what":"NDJSON storage format","why":"Human-readable, appendable, streamable - each event is one line, easy to inspect with standard tools, no need for database setup","when":"2026-01-20T22:33:57.154Z","status":"active","relates_to":{"domains":["ModelEvent"],"aspects":["EventSourcing"]}}}
{"eventType":"EntityCreated","entityType":"decision","entityId":"dec-1768948437291","timestamp":"2026-01-20T22:33:57.291Z","version":1,"payload":{"id":"dec-1768948437291","what":"Embed web bundle in CLI for view command","why":"Zero external dependencies for visualization - user runs 'mental view' and gets instant local server. No npm install, no build step, just works","when":"2026-01-20T22:33:57.291Z","status":"active","relates_to":{"capabilities":["VisualizeModel"]}}}
