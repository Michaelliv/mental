{
  "name": "mental",
  "version": "0.1.0",
  "description": "The mental model layer for agent-written code",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --watch packages/cli/src/index.ts",
    "build": "bun run packages/cli/build.ts && bun run packages/web/build.ts",
    "web:dev": "cd packages/web && bun run dev"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/bun": "latest",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1",
    "typescript": "^5.0.0"
  },
  "author": "Michael Liv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Michaelliv/mental.git"
  },
  "homepage": "https://mentalmodel.sh"
}
